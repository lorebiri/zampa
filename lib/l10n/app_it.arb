  "scaBcs2Text": "Molto magro: costole facilmente visibili, nessun grasso palpabile.",
  "@scaBcs2Text": {
    "description": "SCA-BCS-2 · testo"
  },
  "scaBcs3Text": "Magro: costole facilmente palpabili, vita evidente.",
  "@scaBcs3Text": {
    "description": "SCA-BCS-3 · testo"
  },
  "scaBcs4Text": "Sottile: costole palpabili con poco grasso, vita ben visibile.",
  "@scaBcs4Text": {
    "description": "SCA-BCS-4 · testo"
  },
  "scaBcs5Text": "Ideale: costole palpabili senza eccesso di grasso, vita visibile da sopra.",
  "@scaBcs5Text": {
    "description": "SCA-BCS-5 · testo"
