    "placeholders": {
      "year": {
        "type": "String"
      }
    }
  },
  "prv012Text": "Prima di iniziare la profilassi: antigene della filaria e, nelle zone a rischio, test per la leishmania.",
  "@prv012Text": {
    "description": "PRV-012 · testo"
  },
  "prv013Title": "Inizio profilassi filariosi {year}",
  "@prv013Title": {
