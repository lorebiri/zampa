    "placeholders": {
      "drug": {
        "type": "String"
      }
    }
  },
  "alrFar006Text": "Prevista alle {time}. Se l'hai saltata, non raddoppiare la successiva: chiedi al veterinario cosa fare.",
  "@alrFar006Text": {
    "description": "ALR-FAR-006 · testo · time = HH:MM",
    "placeholders": {
